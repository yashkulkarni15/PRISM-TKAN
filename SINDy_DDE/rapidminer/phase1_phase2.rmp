        <parameter key="log_stdout" value="true"/>
        <parameter key="log_stderr" value="true"/>
        <parameter key="working_directory" value="/Users/yash/Downloads/PRI2M/SINDy_DDE"/>
        <list key="env_variables"/>
      </operator>

      <!-- Read physics_check.csv from the path written by the wrapper -->
      <!-- fil port is NOT connected so it reads from csv_file parameter -->
      <operator activated="true" class="read_csv" compatibility="12.1.001" expanded="true" height="68" name="Read physics_check" width="90" x="313" y="85">
        <parameter key="csv_file" value="/Users/yash/Downloads/PRI2M/SINDy_DDE/rapidminer/outputs/phase1/physics_check.csv"/>
        <parameter key="column_separators" value=","/>
        <parameter key="use_quotes" value="true"/>
        <parameter key="quotes_character" value="&quot;"/>
        <parameter key="skip_comments" value="false"/>
        <parameter key="starting_row" value="1"/>
        <parameter key="parse_numbers" value="true"/>
        <parameter key="decimal_character" value="."/>
